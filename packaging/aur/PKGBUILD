# AUR package: status-cli
# Maintainer: amkisko

pkgname=status-cli
pkgver=0.1.0
pkgrel=1
pkgdesc="Status page CLI — search catalog and check live status"
arch=('x86_64' 'aarch64' 'i686')
url="https://github.com/amkisko/status-cli.rs"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('')  # updpkgsums

prepare() {
  cd "$srcdir/status-cli.rs-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$srcdir/status-cli.rs-$pkgver"
  cargo build --release -p status
}

package() {
  cd "$srcdir/status-cli.rs-$pkgver"
  install -Dm755 "target/release/status" "$pkgdir/usr/bin/status"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 <("$pkgdir/usr/bin/status" completions bash) "$pkgdir/usr/share/bash-completion/completions/status"
  install -Dm644 <("$pkgdir/usr/bin/status" completions zsh) "$pkgdir/usr/share/zsh/site-functions/_status"
  install -Dm644 <("$pkgdir/usr/bin/status" completions fish) "$pkgdir/usr/share/fish/vendor_completions.d/status.fish"
  install -Dm644 <("$pkgdir/usr/bin/status" man) "$pkgdir/usr/share/man/man1/status.1"
}
